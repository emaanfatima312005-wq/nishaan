# ============================================
# NISHAAN - Git Ignore
# ============================================

# -----------------------------
# Node / Next.js
# -----------------------------
node_modules/
.next/
out/
build/

# Next.js / TypeScript
next-env.d.ts
*.tsbuildinfo

# Package managers
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# -----------------------------
# Environment variables
# -----------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*

# Allow example environment files
!.env.example

# -----------------------------
# Python / FastAPI Backend
# -----------------------------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python packaging
*.egg
*.egg-info/
dist/
build/
wheels/

# -----------------------------
# FastAPI / Uvicorn
# -----------------------------
*.log

# -----------------------------
# Database
# -----------------------------
# SQLite databases
*.db
*.sqlite
*.sqlite3

# Local database files
database.db
nishaan.db

# -----------------------------
# AI / ML generated files
# -----------------------------
models/
checkpoints/
*.pt
*.pth
*.bin
*.onnx
*.safetensors

# -----------------------------
# Uploaded / generated media
# -----------------------------
uploads/
media/
tmp/
temp/

# Audio
*.mp3
*.wav
*.m4a
*.ogg
*.flac

# Images
*.png
*.jpg
*.jpeg
*.webp
*.gif

# -----------------------------
# Testing
# -----------------------------
coverage/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# -----------------------------
# IDE / Editors
# -----------------------------
.vscode/
.idea/

# VS Code settings that are machine-specific
*.code-workspace

# -----------------------------
# OS files
# -----------------------------
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------
# Debug / Logs
# -----------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# -----------------------------
# Vercel / Deployment
# -----------------------------
.vercel/

# -----------------------------
# Certificates / Secrets
# -----------------------------
*.pem
*.key
*.crt

# -----------------------------
# Jupyter
# -----------------------------
.ipynb_checkpoints/

# -----------------------------
# Misc
# -----------------------------
.cache/
.temp/

# -----------------------------
# Large GeoNames data
# -----------------------------

backend/data/alternateNames.txt
backend/data/alternateNames.zip

# Backend runtime uploads
backend/uploads/