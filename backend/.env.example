# ============================================================
# NISHAAN — backend environment variables
# ============================================================
# Copy this file to backend/.env for local development,
# or set these as secrets in the deployment platform.

# Groq API key (required) — https://console.groq.com/keys
GROQ_API_KEY=

# PostgreSQL connection string with PostGIS (required).
# The backend enables the postgis extension automatically.
# Neon example:
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Mapillary access token (optional) — https://www.mapillary.com/dashboard/developers
MAPILLARY_ACCESS_TOKEN=

# Comma-separated CORS origins for the API (optional).
# Only needed when the frontend and backend run on separate
# origins (e.g. local development with `next dev`).
ALLOWED_ORIGINS=http://localhost:3000
